{
  "expo": {
    "name": "Everyone English",
    "slug": "everyone-english-ai",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "everyoneenglish",
    "android": {
      "package": "com.nelalemento.everyoneenglish",
      "permissions": [
        "RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/everyone-english-icon.png",
        "backgroundColor": "#EAF3FF"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/everyone-english-icon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Everyone English necesita el micrófono para practicar conversación en inglés.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "icon": "./assets/everyone-english-icon.png"
  }
}
